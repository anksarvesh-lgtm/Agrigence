
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'agrigence@gmail.com'
      );
    }

    // --- PUBLIC ASSETS (Read: Public, Write: Admin) ---
    
    match /articles/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /magazines/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /editorial/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Added missing rules for Store, Popup, Settings, and Leadership
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /popup/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Relaxed rule for Leadership to ensure admins can upload photos without strict email check
    match /leadership/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- USER UPLOADS ---
    
    // Allow any authenticated user to upload to submissions/ and payments/
    // Reading is restricted to signed-in users (Application logic handles specifics via download URLs)
    
    match /submissions/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /payments/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- GLOBAL ADMIN OVERRIDE / DEFAULT DENY OTHERS ---
    // Allows admin to write/read anywhere (fixing any missing path issues), denies others.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
