
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Relaxed Admin Check for Storage
    // Since Storage rules cannot access Firestore to check roles,
    // we allow any authenticated user to write to asset paths.
    // In a production environment, use Custom Claims or strict User ID paths.
    function isAuthorized() {
      return isSignedIn();
    }

    // --- PUBLIC ASSETS (Read: Public, Write: Authorized) ---
    
    match /articles/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorized();
    }

    match /blogs/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorized();
    }

    match /magazines/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorized();
    }

    match /news/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorized();
    }

    match /editorial/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorized();
    }

    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorized();
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorized();
    }

    match /popup/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorized();
    }

    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorized();
    }

    match /leadership/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorized();
    }

    match /seo/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorized();
    }

    // --- USER PROFILES ---
    
    match /users/profiles/initial/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    match /users/profiles/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- USER UPLOADS ---
    
    match /submissions/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /payments/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- AGRIFEED ---
    match /agri_posts/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.resource == null || request.resource.size <= 5 * 1024 * 1024); // 5MB limit
    }

    match /agri_messages/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.resource == null || request.resource.size <= 5 * 1024 * 1024); // 5MB limit
    }

    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.resource == null || request.resource.size <= 5 * 1024 * 1024);
    }

    match /messages/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.resource == null || request.resource.size <= 5 * 1024 * 1024);
    }

    // --- FALLBACK ---
    match /{allPaths=**} {
      allow read, write: if isAuthorized();
    }
  }
}
