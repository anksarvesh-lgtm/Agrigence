
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user is the owner of the document (based on userId field or doc ID)
    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId);
    }

    // Check if user is Admin
    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'ADMIN'] ||
        request.auth.token.email == 'agrigence@gmail.com'
      );
    }

    // --- PUBLIC CONTENT COLLECTIONS (Read: Public, Write: Admin/Specific) ---
    
    match /articles/{docId} {
      allow read: if true;
      allow create: if isSignedIn(); // Allow users to submit articles
      allow update, delete: if isAdmin();
    }
    
    match /blogs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /magazines/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /news/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /editorial_board/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /leadership/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /site_identity/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Site Stats (Visitor Counter)
    match /site_stats/{docId} {
      allow read: if true;
      allow write: if true; // Allow incrementing
    }
    
    match /popup_messages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /subscription_plans/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /static_pages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /branding/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /coupons/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /templates/{docId} {
      allow read, write: if isAdmin();
    }

    // --- INTERACTIVE COLLECTIONS ---

    match /feedback/{docId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Email Trigger Extension Collection
    match /mail/{docId} {
      allow create: if isSignedIn(); 
      allow read, update, delete: if isAdmin();
    }

    // --- USER DATA & SUBMISSIONS ---

    // Users Collection
    match /users/{userId} {
      // Allow read if owner, admin, or if the target profile is an Admin (Public Staff)
      allow read: if isOwner(userId) || isAdmin() || resource.data.role in ['ADMIN', 'SUPER_ADMIN'];
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Submissions
    match /submissions/{submissionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId); 
      allow update, delete: if isAdmin();
    }
    
    // Payments
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    // Inquiries (Contact Form)
    match /inquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Notifications
    match /notifications/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- DEFAULT DENY ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
