{
  "entities": {
    "ToolHistory": {
      "title": "Tool History",
      "description": "Logs of tool usage by users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "toolName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "inputData": { "type": "object" },
        "outputData": { "type": "object" },
        "status": { "type": "string", "enum": ["SUCCESS", "FAILED"] }
      },
      "required": ["userId", "toolName", "timestamp", "inputData", "outputData", "status"]
    },
    "Video": {
      "title": "Video",
      "description": "YouTube video metadata",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnail": { "type": "string" },
        "youtubeId": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["PUBLISHED", "DRAFT"] }
      },
      "required": ["title", "youtubeId", "publishedAt"]
    },
    "VideoSource": {
      "title": "Video Source",
      "description": "YouTube channel or playlist source",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["CHANNEL", "PLAYLIST"] },
        "url": { "type": "string" },
        "isEnabled": { "type": "boolean" },
        "autoSync": { "type": "boolean" },
        "lastSync": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type", "url"]
    }
  },
  "firestore": {
    "/tool_history/{historyId}": {
      "schema": "ToolHistory",
      "description": "Collection of tool usage logs"
    },
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Collection of YouTube videos"
    },
    "/video_sources/{sourceId}": {
      "schema": "VideoSource",
      "description": "Collection of YouTube video sources"
    }
  }
}
