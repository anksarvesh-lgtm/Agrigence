{
  "entities": {
    "ToolHistory": {
      "title": "Tool History",
      "description": "Logs of tool usage by users",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user who used the tool"
        },
        "toolName": {
          "type": "string",
          "description": "Name of the tool used"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the tool was used"
        },
        "inputData": {
          "type": "object",
          "description": "Input data provided to the tool"
        },
        "outputData": {
          "type": "object",
          "description": "Output generated by the tool"
        },
        "status": {
          "type": "string",
          "enum": ["SUCCESS", "FAILED"],
          "description": "Status of the tool execution"
        }
      },
      "required": ["userId", "toolName", "timestamp", "inputData", "outputData", "status"]
    }
  },
  "firestore": {
    "/tool_history/{historyId}": {
      "schema": "ToolHistory",
      "description": "Collection of tool usage logs"
    }
  }
}
