{
  "entities": {
    "ToolHistory": {
      "title": "Tool History",
      "description": "Logs of tool usage by users",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user who used the tool"
        },
        "toolName": {
          "type": "string",
          "description": "Name of the tool used"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the tool was used"
        },
        "inputData": {
          "type": "object",
          "description": "Input data provided to the tool"
        },
        "outputData": {
          "type": "object",
          "description": "Output generated by the tool"
        },
        "status": {
          "type": "string",
          "enum": ["SUCCESS", "FAILED"],
          "description": "Status of the tool execution"
        }
      },
      "required": ["userId", "toolName", "timestamp", "inputData", "outputData", "status"]
    },
    "Blog": {
      "title": "Blog Post",
      "description": "Daily trending agricultural blog posts",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "metaDescription": { "type": "string" },
        "content": { "type": "string" },
        "schema": { "type": "object" },
        "keyword": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "author": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "featuredImage": { "type": "string" }
      },
      "required": ["title", "slug", "content", "publishedAt"]
    },
    "CropPlan": {
      "title": "Crop Plan",
      "description": "AI-generated crop planning and suggestions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "input": { "type": "object" },
        "recommendations": { "type": "string" },
        "crops": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["userId", "timestamp", "input", "recommendations", "crops"]
    }
  },
  "firestore": {
    "/tool_history/{historyId}": {
      "schema": "ToolHistory",
      "description": "Collection of tool usage logs"
    },
    "/blogs/{blogId}": {
      "schema": "Blog",
      "description": "Collection of AI-generated blog posts"
    },
    "/crop_plans/{planId}": {
      "schema": "CropPlan",
      "description": "User-specific crop plans"
    }
  }
}
